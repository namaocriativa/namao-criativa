generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  category    String?
  description String?
  phone       String?
  whatsapp    String?
  email       String?
  website     String?
  address     String?
  city        String?
  state       String?
  country     String?
  latitude    Float?
  longitude   Float?
  instagram   String?
  facebook    String?
  linkedin    String?
  services    Json?
  rating      Float?
  reviewCount Int?
  metadata    Json?
  generateConfig      Json?
  landingSlug         String?   @unique
  landingStatus       String    @default("none")
  landingBuiltAt      DateTime?
  activeLandingJobId  String?
  publicSiteId        String?   @unique
  chatEnabled         Boolean   @default(false)
  publishedOrigin     String?
  vercelProjectId     String?
  vercelDeploymentId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images  LeadImage[]
  sources LeadSource[]
  users   User[]
  invites Invite[]
  instagramConnections InstagramConnection[]
  landingJobs LandingJob[]
  landingGenerations LandingGeneration[]
  chatSessions ChatSession[]
  chatEvents   ChatEvent[]
  activities   LeadActivity[]
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  channel   String
  kind      String
  title     String
  summary   String
  payload   Json?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model ChatSession {
  id           String   @id
  leadId       String
  tokenHash    String   @unique
  expiresAt    DateTime
  ipHash       String
  origin       String?
  status       String   @default("active")
  messageCount Int      @default(0)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lead     Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  events   ChatEvent[]

  @@index([leadId])
  @@index([expiresAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model ChatEvent {
  id        String   @id @default(cuid())
  leadId    String
  sessionId String?
  name      String
  payload   Json?
  createdAt DateTime @default(now())

  lead    Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  session ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([sessionId])
}

model LandingJob {
  id               String   @id @default(cuid())
  leadId           String
  slug             String
  status           String   @default("queued")
  log              Json     @default("[]")
  error            String?
  cancelRequested  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  generations LandingGeneration[]

  @@index([leadId])
  @@index([status])
}

model LandingGeneration {
  id             String   @id @default(cuid())
  leadId         String
  jobId          String   @unique
  pageSpec       Json
  componentIds   String
  themeStyle     String
  category       String?
  visualScore    Int?
  screenshotPath String?
  humanRating    Int?
  conversion     Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lead Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  job  LandingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([themeStyle])
  @@index([category])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("CLIENT")
  leadId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lead                 Lead?                  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  instagramConnections InstagramConnection[]

  @@index([leadId])
}

model Invite {
  id        String   @id @default(cuid())
  token     String   @unique
  leadId    String
  phone     String?
  status    String   @default("PENDING")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model InstagramConnection {
  id             String    @id @default(cuid())
  userId         String
  leadId         String
  igUserId       String
  username       String?
  accessToken    String
  tokenExpiresAt DateTime?
  scopes         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId])
  @@index([userId])
}

model LeadSource {
  id         String   @id @default(cuid())
  leadId     String
  provider   String
  url        String?
  externalId String?
  data       Json?
  createdAt  DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadImage {
  id        String   @id @default(cuid())
  leadId    String
  source    String
  sourceUrl String
  localPath String
  filename  String
  mimeType  String?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, sourceUrl])
  @@index([leadId])
}

model Package {
  id              String   @id @default(cuid())
  name            String
  summary         String?
  description     String?
  price           Float?
  currency        String   @default("BRL")
  benefits        Json?
  whatsappMessage String?
  emailSubject    String?
  emailBody       String?
  status          String   @default("draft")
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  images PackageImage[]
}

model PackageImage {
  id        String   @id @default(cuid())
  packageId String
  sourceUrl String
  localPath String
  filename  String
  mimeType  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model AppSetting {
  key   String @id
  value String
}
