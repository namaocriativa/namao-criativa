generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  leads                  Lead[]
  customers              Customer[]
  clientAccounts         ClientAccount[]
  invites                Invite[]
  inviteRequests         InviteRequest[]
  packages               Package[]
  offerTemplates         OfferTemplate[]
  appSettings            AppSetting[]
  imageProjects          ImageProject[]
  videoProjects          VideoProject[]
  creativeCharacters     CreativeCharacter[]
  creativeMovies         CreativeMovie[]
  creativeStartEndClips  CreativeStartEndClip[]
  creativeUgcClips       CreativeUgcClip[]
  calendarPosts          ContentCalendarPost[]
  proposals              Proposal[]

  @@index([status])
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  category    String?
  description String?
  phone       String?
  whatsapp    String?
  email       String?
  website     String?
  address     String?
  city        String?
  state       String?
  country     String?
  latitude    Float?
  longitude   Float?
  instagram   String?
  facebook    String?
  linkedin    String?
  services    Json?
  rating      Float?
  reviewCount Int?
  metadata    Json?
  generateConfig      Json?
  landingSlug         String?   @unique
  landingStatus       String    @default("none")
  landingBuiltAt      DateTime?
  activeLandingJobId  String?
  publicSiteId        String?   @unique
  chatEnabled         Boolean   @default(false)
  publishedOrigin     String?
  vercelProjectId     String?
  vercelDeploymentId  String?
  websiteProjectId    String?
  websiteDeployType   String?
  websiteRepo         String?
  websiteFramework    String?
  websiteDomain       String?
  fromPublicSignup    Boolean  @default(false)
  tenantId            String
  createdByUserId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User? @relation("LeadCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  images  LeadImage[]
  sources LeadSource[]
  clientAccounts ClientAccount[]
  invites Invite[]
  instagramConnections InstagramConnection[]
  landingJobs LandingJob[]
  landingGenerations LandingGeneration[]
  chatSessions ChatSession[]
  chatEvents   ChatEvent[]
  activities   LeadActivity[]
  studioShares StudioLeadShare[]
  calendarPosts ContentCalendarPost[]
  proposals     Proposal[]

  @@index([fromPublicSignup])
  @@index([createdByUserId])
  @@index([tenantId])
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  category    String?
  description String?
  phone       String?
  whatsapp    String?
  email       String?
  website     String?
  address     String?
  city        String?
  state       String?
  country     String?
  latitude    Float?
  longitude   Float?
  instagram   String?
  facebook    String?
  linkedin    String?
  services    Json?
  rating      Float?
  reviewCount Int?
  metadata    Json?
  generateConfig      Json?
  landingSlug         String?   @unique
  landingStatus       String    @default("none")
  landingBuiltAt      DateTime?
  activeLandingJobId  String?
  publicSiteId        String?   @unique
  chatEnabled         Boolean   @default(false)
  publishedOrigin     String?
  vercelProjectId     String?
  vercelDeploymentId  String?
  websiteProjectId    String?
  websiteDeployType   String?
  websiteRepo         String?
  websiteFramework    String?
  websiteDomain       String?
  fromPublicSignup    Boolean  @default(false)
  tenantId            String
  createdByUserId     String?
  convertedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User? @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  images  LeadImage[]
  sources LeadSource[]
  clientAccounts ClientAccount[]
  invites Invite[]
  instagramConnections InstagramConnection[]
  landingJobs LandingJob[]
  landingGenerations LandingGeneration[]
  chatSessions ChatSession[]
  chatEvents   ChatEvent[]
  activities   LeadActivity[]
  studioShares StudioLeadShare[]
  calendarPosts ContentCalendarPost[]
  proposals     Proposal[]

  @@index([fromPublicSignup])
  @@index([createdByUserId])
  @@index([tenantId])
}

model LeadActivity {
  id         String   @id @default(cuid())
  leadId     String?
  customerId String?
  channel    String
  kind       String
  title      String
  summary    String
  payload    Json?
  createdAt  DateTime @default(now())

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([customerId, createdAt])
}

model ChatSession {
  id              String   @id
  leadId          String?
  customerId      String?
  clientAccountId String?
  channel         String   @default("landing")
  tokenHash       String   @unique
  expiresAt       DateTime
  ipHash          String
  origin          String?
  status          String   @default("active")
  messageCount    Int      @default(0)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  clientAccount ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  messages      ChatMessage[]
  events        ChatEvent[]

  @@index([leadId])
  @@index([customerId])
  @@index([clientAccountId, channel])
  @@index([channel])
  @@index([expiresAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model ChatEvent {
  id         String   @id @default(cuid())
  leadId     String?
  customerId String?
  sessionId  String?
  name       String
  payload    Json?
  createdAt  DateTime @default(now())

  lead     Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  session  ChatSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([customerId])
  @@index([sessionId])
}

model LandingJob {
  id               String   @id @default(cuid())
  leadId           String?
  customerId       String?
  slug             String
  status           String   @default("queued")
  log              Json     @default("[]")
  error            String?
  cancelRequested  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  generations LandingGeneration[]

  @@index([leadId])
  @@index([customerId])
  @@index([status])
}

model LandingGeneration {
  id             String   @id @default(cuid())
  leadId         String?
  customerId     String?
  jobId          String   @unique
  pageSpec       Json
  componentIds   String
  themeStyle     String
  category       String?
  visualScore    Int?
  screenshotPath String?
  humanRating    Int?
  conversion     Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lead     Lead?      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job      LandingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([customerId])
  @@index([themeStyle])
  @@index([category])
}

/// Staff do Studio (`ROOT` | `ADMIN` | `OPERATOR`). Login do portal é `ClientAccount`.
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  role            String   @default("OPERATOR")
  tenantId        String?
  canAccessImages Boolean  @default(false)
  canAccessVideos Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  studioActivities     StudioUserActivity[]
  createdLeads         Lead[]               @relation("LeadCreatedBy")
  createdCustomers     Customer[]           @relation("CustomerCreatedBy")
  studioLeadShares     StudioLeadShare[]
  createdImageProjects     ImageProject[]        @relation("ImageProjectCreatedBy")
  createdVideoProjects     VideoProject[]        @relation("VideoProjectCreatedBy")
  createdCreativeCharacters CreativeCharacter[]  @relation("CreativeCharacterCreatedBy")
  createdCreativeMovies     CreativeMovie[]      @relation("CreativeMovieCreatedBy")
  createdStartEndClips      CreativeStartEndClip[] @relation("CreativeStartEndClipCreatedBy")
  createdUgcClips           CreativeUgcClip[]      @relation("CreativeUgcClipCreatedBy")
  createdCalendarPosts      ContentCalendarPost[] @relation("ContentCalendarPostCreatedBy")

  @@index([tenantId])
}

model ClientAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  tenantId     String
  leadId       String?
  customerId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead                 Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer             Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  instagramConnections InstagramConnection[]
  chatSessions         ChatSession[]

  @@index([leadId])
  @@index([customerId])
  @@index([tenantId])
}

model StudioLeadShare {
  id         String   @id @default(cuid())
  leadId     String?
  customerId String?
  userId     String
  createdAt  DateTime @default(now())

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leadId, userId])
  @@unique([customerId, userId])
  @@index([userId])
  @@index([leadId])
  @@index([customerId])
}

model StudioUserActivity {
  id        String   @id @default(cuid())
  userId    String
  method    String
  path      String
  kind      String
  title     String
  summary   String
  payload   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Invite {
  id         String   @id @default(cuid())
  token      String   @unique
  tenantId   String
  leadId     String?
  customerId String?
  phone      String?
  status     String   @default("PENDING")
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([customerId])
  @@index([tenantId])
}

model InstagramConnection {
  id              String    @id @default(cuid())
  clientAccountId String
  leadId          String?
  customerId      String?
  igUserId        String
  username        String?
  accessToken     String
  tokenExpiresAt  DateTime?
  scopes          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  clientAccount ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  lead          Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([leadId])
  @@unique([customerId])
  @@index([clientAccountId])
}

model LeadSource {
  id         String   @id @default(cuid())
  leadId     String?
  customerId String?
  provider   String
  url        String?
  externalId String?
  data       Json?
  createdAt  DateTime @default(now())

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([customerId])
}

model LeadImage {
  id         String   @id @default(cuid())
  leadId     String?
  customerId String?
  source     String
  sourceUrl  String
  localPath  String
  filename   String
  mimeType   String?
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([leadId, sourceUrl])
  @@unique([customerId, sourceUrl])
  @@index([leadId])
  @@index([customerId])
}

model Package {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  summary     String?
  description String?
  price       Float?
  promoPrice  Float?
  currency    String   @default("BRL")
  benefits    Json?
  status      String   @default("draft")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  images    PackageImage[]
  proposals Proposal[]

  @@index([tenantId])
}

model Proposal {
  id               String    @id @default(cuid())
  tenantId         String
  leadId           String?
  customerId       String?
  packageId        String?
  packageSnapshot  Json
  status           String    @default("pending")
  paymentStatus    String    @default("pending")
  collectPayment   Boolean   @default(true)
  acceptedAt       DateTime?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  package  Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([customerId])
  @@index([tenantId])
}

model OfferTemplate {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  emailSubject    String
  emailBody       String
  whatsappMessage String
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

model PackageImage {
  id        String   @id @default(cuid())
  packageId String
  sourceUrl String
  localPath String
  filename  String
  mimeType  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model AppSetting {
  id       String @id @default(cuid())
  tenantId String
  key      String
  value    String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key])
  @@index([tenantId])
}

model InviteRequest {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String
  instagram String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([email])
  @@index([tenantId])
}

model CreativeCharacter {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  appearance      String
  personality     String   @default("")
  identityPrompt  String   @default("")
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User?                    @relation("CreativeCharacterCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assets       CreativeCharacterAsset[]
  movieShots   CreativeMovieShot[]
  movieCast    CreativeMovieShotCast[]
  ugcClips   CreativeUgcClip[]

  @@index([createdByUserId])
  @@index([updatedAt])
  @@index([tenantId])
}

model CreativeCharacterAsset {
  id          String   @id @default(cuid())
  characterId String
  kind        String
  localPath   String
  filename    String
  mimeType    String?
  createdAt   DateTime @default(now())

  character       CreativeCharacter       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  movieShotCasts   CreativeMovieShotCast[]

  @@index([characterId, createdAt])
  @@index([kind])
}

model CreativeMovie {
  id              String   @id @default(cuid())
  tenantId        String
  title           String
  aspectRatio     String   @default("16:9")
  duration        String   @default("8s")
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User?               @relation("CreativeMovieCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  shots     CreativeMovieShot[]

  @@index([createdByUserId])
  @@index([updatedAt])
  @@index([tenantId])
}

model CreativeMovieShot {
  id          String   @id @default(cuid())
  movieId     String
  characterId String
  sortOrder   Int      @default(0)
  scene       String
  action      String
  dialogue    String   @default("")
  framing     String   @default("plano_medio")
  camera      String   @default("fixa")
  status      String   @default("draft")
  error       String   @default("")
  localPath   String   @default("")
  filename    String   @default("")
  mimeType    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movie     CreativeMovie          @relation(fields: [movieId], references: [id], onDelete: Cascade)
  character CreativeCharacter      @relation(fields: [characterId], references: [id], onDelete: Restrict)
  cast      CreativeMovieShotCast[]

  @@index([movieId, sortOrder])
  @@index([characterId])
}

model CreativeMovieShotCast {
  shotId      String
  characterId String
  assetId     String?
  sortOrder   Int    @default(0)

  shot      CreativeMovieShot     @relation(fields: [shotId], references: [id], onDelete: Cascade)
  character CreativeCharacter     @relation(fields: [characterId], references: [id], onDelete: Restrict)
  asset     CreativeCharacterAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@id([shotId, characterId])
  @@index([characterId])
  @@index([shotId, sortOrder])
  @@index([assetId])
}

model CreativeStartEndClip {
  id              String   @id @default(cuid())
  tenantId        String
  prompt          String   @default("")
  duration        String   @default("5s")
  aspectRatio     String   @default("16:9")
  resolution      String   @default("720p")
  status          String   @default("draft")
  error           String   @default("")
  firstFramePath  String   @default("")
  firstFrameName  String   @default("")
  firstFrameMime  String?
  lastFramePath   String   @default("")
  lastFrameName   String   @default("")
  lastFrameMime   String?
  localPath       String   @default("")
  filename        String   @default("")
  mimeType        String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User? @relation("CreativeStartEndClipCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([createdByUserId])
  @@index([updatedAt])
  @@index([tenantId])
}

model CreativeUgcClip {
  id              String   @id @default(cuid())
  tenantId        String
  characterId     String
  prompt          String   @default("")
  duration        String   @default("8s")
  aspectRatio     String   @default("9:16")
  resolution      String   @default("720p")
  status          String   @default("draft")
  error           String   @default("")
  firstFramePath  String   @default("")
  firstFrameName  String   @default("")
  firstFrameMime  String?
  productPath     String   @default("")
  productName     String   @default("")
  productMime     String?
  localPath       String   @default("")
  filename        String   @default("")
  mimeType        String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  character CreativeCharacter @relation(fields: [characterId], references: [id], onDelete: Restrict)
  createdBy User?             @relation("CreativeUgcClipCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([createdByUserId])
  @@index([characterId])
  @@index([updatedAt])
  @@index([tenantId])
}

model ImageProject {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  createdByUserId String?
  settings        Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User?          @relation("ImageProjectCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  messages  ImageMessage[]
  assets    ImageAsset[]

  @@index([createdByUserId])
  @@index([updatedAt])
  @@index([tenantId])
}

model ImageMessage {
  id          String   @id @default(cuid())
  projectId   String
  role        String
  kind        String   @default("generation")
  status      String?
  text        String?
  thoughts    String?
  model       String?
  settings    Json?
  usage       Json?
  toolName    String?
  toolPayload Json?
  createdAt   DateTime @default(now())

  project ImageProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets  ImageAsset[]

  @@index([projectId, createdAt])
  @@index([projectId, kind])
}

model ImageAsset {
  id        String   @id @default(cuid())
  projectId String
  messageId String?
  kind      String
  localPath String
  filename  String
  mimeType  String?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  project ImageProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  message ImageMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([messageId])
  @@index([kind])
}

model VideoProject {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  createdByUserId String?
  settings        Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User?          @relation("VideoProjectCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  messages  VideoMessage[]
  assets    VideoAsset[]

  @@index([createdByUserId])
  @@index([updatedAt])
  @@index([tenantId])
}

model VideoMessage {
  id                    String   @id @default(cuid())
  projectId             String
  role                  String
  kind                  String   @default("generation")
  status                String?
  text                  String?
  thoughts              String?
  model                 String?
  settings              Json?
  usage                 Json?
  toolName              String?
  toolPayload           Json?
  providerInteractionId String?
  createdAt             DateTime @default(now())

  project VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets  VideoAsset[]

  @@index([projectId, createdAt])
  @@index([projectId, kind])
}

model VideoAsset {
  id        String   @id @default(cuid())
  projectId String
  messageId String?
  kind      String
  localPath String
  filename  String
  mimeType  String?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  project VideoProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  message VideoMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([messageId])
  @@index([kind])
}

model ContentCalendarPost {
  id              String   @id @default(cuid())
  tenantId        String
  title           String
  caption         String   @default("")
  scheduledAt     DateTime
  status          String   @default("draft")
  leadId          String?
  customerId      String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("ContentCalendarPostCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  targets   ContentCalendarTarget[]
  assets    ContentCalendarAsset[]

  @@index([scheduledAt, status])
  @@index([status])
  @@index([leadId])
  @@index([customerId])
  @@index([createdByUserId])
  @@index([tenantId])
}

model ContentCalendarTarget {
  id          String    @id @default(cuid())
  postId      String
  platform    String
  status      String    @default("pending")
  error       String    @default("")
  externalId  String    @default("")
  permalink   String    @default("")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  post ContentCalendarPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, platform])
  @@index([status])
}

model ContentCalendarAsset {
  id        String   @id @default(cuid())
  postId    String
  kind      String
  localPath String
  filename  String
  mimeType  String?
  source    String   @default("upload")
  sourceId  String   @default("")
  createdAt DateTime @default(now())

  post ContentCalendarPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}
