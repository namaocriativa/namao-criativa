generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  category    String?
  description String?
  phone       String?
  whatsapp    String?
  email       String?
  website     String?
  address     String?
  city        String?
  state       String?
  country     String?
  latitude    Float?
  longitude   Float?
  instagram   String?
  facebook    String?
  linkedin    String?
  services    Json?
  rating      Float?
  reviewCount Int?
  metadata    Json?
  generateConfig      Json?
  landingSlug         String?   @unique
  landingStatus       String    @default("none")
  landingBuiltAt      DateTime?
  activeLandingJobId  String?
  publicSiteId        String?   @unique
  chatEnabled         Boolean   @default(false)
  publishedOrigin     String?
  vercelProjectId     String?
  vercelDeploymentId  String?
  fromPublicSignup    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images  LeadImage[]
  sources LeadSource[]
  users   User[]
  invites Invite[]
  instagramConnections InstagramConnection[]
  landingJobs LandingJob[]
  landingGenerations LandingGeneration[]
  chatSessions ChatSession[]
  chatEvents   ChatEvent[]
  activities   LeadActivity[]

  @@index([fromPublicSignup])
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  category    String?
  description String?
  phone       String?
  whatsapp    String?
  email       String?
  website     String?
  address     String?
  city        String?
  state       String?
  country     String?
  latitude    Float?
  longitude   Float?
  instagram   String?
  facebook    String?
  linkedin    String?
  services    Json?
  rating      Float?
  reviewCount Int?
  metadata    Json?
  generateConfig      Json?
  landingSlug         String?   @unique
  landingStatus       String    @default("none")
  landingBuiltAt      DateTime?
  activeLandingJobId  String?
  publicSiteId        String?   @unique
  chatEnabled         Boolean   @default(false)
  publishedOrigin     String?
  vercelProjectId     String?
  vercelDeploymentId  String?
  fromPublicSignup    Boolean  @default(false)
  convertedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images  LeadImage[]
  sources LeadSource[]
  users   User[]
  invites Invite[]
  instagramConnections InstagramConnection[]
  landingJobs LandingJob[]
  landingGenerations LandingGeneration[]
  chatSessions ChatSession[]
  chatEvents   ChatEvent[]
  activities   LeadActivity[]

  @@index([fromPublicSignup])
}

model LeadActivity {
  id         String   @id @default(cuid())
  leadId     String?
  customerId String?
  channel    String
  kind       String
  title      String
  summary    String
  payload    Json?
  createdAt  DateTime @default(now())

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([customerId, createdAt])
}

model ChatSession {
  id           String   @id
  leadId       String?
  customerId   String?
  userId       String?
  channel      String   @default("landing")
  tokenHash    String   @unique
  expiresAt    DateTime
  ipHash       String
  origin       String?
  status       String   @default("active")
  messageCount Int      @default(0)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lead     Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages ChatMessage[]
  events   ChatEvent[]

  @@index([leadId])
  @@index([customerId])
  @@index([userId, channel])
  @@index([channel])
  @@index([expiresAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model ChatEvent {
  id         String   @id @default(cuid())
  leadId     String?
  customerId String?
  sessionId  String?
  name       String
  payload    Json?
  createdAt  DateTime @default(now())

  lead     Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  session  ChatSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([customerId])
  @@index([sessionId])
}

model LandingJob {
  id               String   @id @default(cuid())
  leadId           String?
  customerId       String?
  slug             String
  status           String   @default("queued")
  log              Json     @default("[]")
  error            String?
  cancelRequested  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  generations LandingGeneration[]

  @@index([leadId])
  @@index([customerId])
  @@index([status])
}

model LandingGeneration {
  id             String   @id @default(cuid())
  leadId         String?
  customerId     String?
  jobId          String   @unique
  pageSpec       Json
  componentIds   String
  themeStyle     String
  category       String?
  visualScore    Int?
  screenshotPath String?
  humanRating    Int?
  conversion     Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lead     Lead?      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job      LandingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([customerId])
  @@index([themeStyle])
  @@index([category])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("CLIENT")
  leadId       String?
  customerId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  instagramConnections InstagramConnection[]
  chatSessions ChatSession[]

  @@index([leadId])
  @@index([customerId])
}

model Invite {
  id         String   @id @default(cuid())
  token      String   @unique
  leadId     String?
  customerId String?
  phone      String?
  status     String   @default("PENDING")
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([customerId])
}

model InstagramConnection {
  id             String    @id @default(cuid())
  userId         String
  leadId         String?
  customerId     String?
  igUserId       String
  username       String?
  accessToken    String
  tokenExpiresAt DateTime?
  scopes         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([leadId])
  @@unique([customerId])
  @@index([userId])
}

model LeadSource {
  id         String   @id @default(cuid())
  leadId     String?
  customerId String?
  provider   String
  url        String?
  externalId String?
  data       Json?
  createdAt  DateTime @default(now())

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([customerId])
}

model LeadImage {
  id         String   @id @default(cuid())
  leadId     String?
  customerId String?
  source     String
  sourceUrl  String
  localPath  String
  filename   String
  mimeType   String?
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([leadId, sourceUrl])
  @@unique([customerId, sourceUrl])
  @@index([leadId])
  @@index([customerId])
}

model Package {
  id              String   @id @default(cuid())
  name            String
  summary         String?
  description     String?
  price           Float?
  currency        String   @default("BRL")
  benefits        Json?
  whatsappMessage String?
  emailSubject    String?
  emailBody       String?
  status          String   @default("draft")
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  images PackageImage[]
}

model PackageImage {
  id        String   @id @default(cuid())
  packageId String
  sourceUrl String
  localPath String
  filename  String
  mimeType  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model AppSetting {
  key   String @id
  value String
}

model InviteRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  instagram String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}
