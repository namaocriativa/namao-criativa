# Docker publica Postgres em 5433 no host (5432 fica livre para o Basidio).
DATABASE_URL="postgresql://namao:namao@localhost:5433/namao"
GOOGLE_PLACES_API_KEY=
PORT=3000
# Docker (host): PLATFORM_PORT=4000 no .env da raiz — mapeia 4000→3000 no container.
# Nest no host (sem o serviço platform do compose): PORT=4000
# Studio/website leem PLATFORM_PORT (ou VITE_API_URL) do .env da raiz.

# Redis — cache infinito de discovery (limpeza manual na UI)
# Com Docker: docker compose up -d redis
# Dev local (server no host): REDIS_URL=redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Crawl4AI — enrichment de leads com website
# Opção A (local): npm run crawler:setup
# Opção B (Docker só crawl4ai): docker compose up -d crawl4ai
#   CRAWL4AI_URL=http://localhost:11235
# Compose sobe infra + API Nest (watch). O Vite em apps/studio no host aponta para
# http://localhost:${PLATFORM_PORT:-4000} (veja PLATFORM_PORT no .env da raiz).
# API Nest no host (sem o serviço platform do compose): npm run dev:platform
CRAWL4AI_URL=
CRAWL4AI_API_TOKEN=local-dev-crawl4ai-token
CRAWL4AI_PYTHON=

# Gemini — Google AI Studio (aba Config + chat público das LPs).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Origem pública da API (chat Gemini) injetada nas LPs.
# Dev local: http://localhost:4000 (PLATFORM_PORT do Docker)
# Produção: https://api.namaocriativa.com.br
PUBLIC_CHAT_API_ORIGIN=http://localhost:4000
# Pasta dos projetos Vite (default: <monorepo>/leads)
LEADS_DIR=

# Pexels — vídeo stock do nicho no pipeline de landing (opcional)
# https://www.pexels.com/api/
PEXELS_API_KEY=

# Vercel — publica o dist/ de cada lead após o build.
# Token: vercel.com/account/tokens (scope da conta ou do time).
VERCEL_TOKEN=
# Opcional, se os projetos forem de um team:
VERCEL_TEAM_ID=
# false para só publicar no botão (default: publica sozinho quando há token)
VERCEL_AUTO_DEPLOY=

# Container GTM compartilhado da Namão (injetado no HTML das landings).
# Ex.: GTM-XXXXXXX. Vazio = não injeta tags. Dashboard lê a propriedade GA4 na API.
GTM_CONTAINER_ID=

# Auth JWT — em produção a API recusa placeholder de desenvolvimento
JWT_SECRET=dev-jwt-secret-change-me
# Primeiro admin do studio (cria a conta se o e-mail ainda não existir)
STUDIO_ADMIN_EMAIL=admin@namao.local
STUDIO_ADMIN_PASSWORD=changeme123

# Site público Namão Criativa (cadastro/login)
NAMAO_PUBLIC_URL=http://localhost:5174
# Origem do studio (CORS extra; em Pages o proxy é same-origin)
NAMAO_STUDIO_URL=http://localhost:5173
# WhatsApp da Namão (CTA do e-mail de apresentação). Ex.: +5519997306695
NAMAO_WHATSAPP=

# Resend — e-mail de acesso do lead (placeholder; preencher em produção)
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM=Namão Criativa <noreply@seudominio.com>

# Instagram Graph API (preencher quando o App Meta existir)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/auth/instagram/callback
META_GRAPH_VERSION=v21.0

# Evolution WhatsApp — após cloud/apply no Coolify, preencher com a URL pública
# e o AUTHENTICATION_API_KEY (mesmo valor de EVOLUTION_API_KEY em cloud/.env / state.json)
# Docs: cloud/README.md
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=namao

# Google Analytics 4 — dashboard do cliente no site Namão (Data API)
# Property ID numérico + JSON da service account (Viewer na propriedade)
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
