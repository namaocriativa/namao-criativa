generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/mongo"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

model InviteRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  instagram String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}
