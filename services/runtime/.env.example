# Mesmo banco do platform (Prisma). Em dev local aponta para o SQLite compartilhado.
DATABASE_URL="file:./dev.db"
PORT=3001

# Redis — rate limit do chat (ip / sessão / site). Sem Redis, cai para memória.
REDIS_URL=redis://localhost:6379

# Gemini — obrigatório em produção. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Origens extras de preview (além de localhost e publishedOrigin no banco)
NAMAO_PUBLIC_URL=http://localhost:5174

# Auth JWT — use o mesmo valor do platform para o Instagram OAuth continuar válido
JWT_SECRET=dev-jwt-secret-change-me

# Pasta opcional dos projetos Vite. Na nuvem deixe vazio — o contexto vem do Prisma.
LEADS_DIR=

# MongoDB — pedidos públicos de convite (POST /invite-requests).
# Em Coolify: gerado pelo stack cloud/ (replica set rs0). Ver cloud/README.md
# Replica set obrigatório para Prisma. Sem isso, o chat segue; POST /invite-requests retorna 503.
MONGODB_URL="mongodb+srv://USER:PASS@cluster.mongodb.net/namao?retryWrites=true&w=majority"
