# Coolify API — https://coolify.fungalia.com.br
# Keys & Tokens → API tokens (abilities: read, write, deploy)
COOLIFY_BASE_URL=https://coolify.fungalia.com.br
COOLIFY_API_TOKEN=

# Project / environment / server (bootstrap resolves UUIDs)
COOLIFY_PROJECT_NAME=namao
COOLIFY_ENVIRONMENT_NAME=production
COOLIFY_SERVER_NAME=localhost

# Public API Docker image (published to GHCR)
# Package no monorepo: @namao/platform → imagem/app Coolify: namao-api
# Publicado pelo CD em .github/workflows/cd-runtime.yml
RUNTIME_IMAGE_NAME=ghcr.io/namaocriativa/namao-api
RUNTIME_IMAGE_TAG=latest

# Secrets injected into the public API
GEMINI_API_KEY=
JWT_SECRET=change-me-in-production
# PostgreSQL (Coolify database or managed). SQLite file: não funciona na VPS.
DATABASE_URL=
REDIS_URL=
NAMAO_PUBLIC_URL=

# Google Analytics 4 — dashboard do cliente no site Namão (Data API)
# Property ID numérico + JSON da service account (Viewer na propriedade)
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# Optional public domains (omit until DNS is ready)
# RUNTIME_DOMAIN=https://api.namaocriativa.com.br
# EVOLUTION_DOMAIN=https://evolution.namaocriativa.com.br

# Evolution — AUTHENTICATION_API_KEY used by platform as EVOLUTION_API_KEY
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=namao
# SERVER_URL for Evolution (internal Coolify URL or public domain)
EVOLUTION_SERVER_URL=

# Evolution Postgres credentials (generated if empty on first apply)
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_POSTGRES_DB=evolution

# Cloudflare Pages — @namao/website (npm run cloud:website)
# Token: dash.cloudflare.com/profile/api-tokens
# Template: "Edit Cloudflare Pages" (Account.Cloudflare Pages Edit + Account Settings Read)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=namao-website
# Custom domain (omit until DNS is on Cloudflare or CNAME is ready)
# WEBSITE_DOMAIN=namaocriativa.com.br
# Same-origin API proxy written to apps/website/public/_redirects (gitignored)
# WEBSITE_API_ORIGIN=https://api.namaocriativa.com.br
