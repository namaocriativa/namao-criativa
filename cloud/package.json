{
  "name": "@namao/cloud",
  "private": true,
  "version": "0.0.1",
  "description": "Infra as Code for Coolify (API, Evolution) and Cloudflare Pages",
  "type": "module",
  "scripts": {
    "bootstrap": "tsx scripts/bootstrap.ts",
    "plan": "tsx scripts/plan.ts",
    "apply": "tsx scripts/apply.ts",
    "deploy": "tsx scripts/deploy.ts",
    "test": "tsx --test lib/*.spec.ts",
    "website": "tsx scripts/website.ts",
    "website:plan": "tsx scripts/website.ts --plan",
    "website:redirects": "tsx scripts/write-website-redirects.ts",
    "studio": "tsx scripts/studio.ts",
    "studio:plan": "tsx scripts/studio.ts --plan",
    "studio:check-env": "tsx scripts/check-studio-pages-env.ts",
    "pages": "tsx scripts/website.ts && tsx scripts/studio.ts",
    "pages:plan": "tsx scripts/website.ts --plan && tsx scripts/studio.ts --plan",
    "mail-dns": "tsx scripts/mail-dns.ts",
    "mail-dns:plan": "tsx scripts/mail-dns.ts --plan"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3"
  }
}
