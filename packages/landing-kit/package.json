{
  "name": "@namao/landing-kit",
  "version": "0.0.1",
  "private": true,
  "description": "Closed React components + Zod page spec for deterministic landings",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./theme.css": "./src/theme/tailwind.css"
  },
  "files": [
    "dist",
    "src",
    "previews"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/styles.css','dist/styles.css'); require('fs').mkdirSync('dist/theme',{recursive:true}); require('fs').copyFileSync('src/theme/tailwind.css','dist/theme/tailwind.css')\"",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "catalog:previews": "tsx src/scripts/generate-previews.ts",
    "gallery": "vite --config gallery/vite.config.ts"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "motion": "^12.23.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "@react-three/drei": "^10.7.4",
    "@react-three/fiber": "^9.3.0",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  }
}
